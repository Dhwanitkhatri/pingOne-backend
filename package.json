{
  "name": "pingone-backend",
  "version": "0.1.0",
  "description": "PingOne — unified cross-app messaging backend (WhatsApp, Telegram, Gmail, SMS)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "prisma migrate deploy && prisma generate && node src/server.js",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "lint": "eslint .",
    "worker": "prisma generate && node src/worker.js",
    "dev:worker": "nodemon src/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:constraints": "prisma db execute --file ./prisma/sql/constraints.sql --schema ./prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma migrate dev --name init && npm run db:constraints && npm run db:seed",
    "test:api": "node tests/api.e2e.mjs",
    "test:api:quick": "node tests/api.e2e.mjs --quick",
    "test:send-preflight": "node --test tests/twilio-send-preflight.test.js",
    "test:webhooks": "node --test tests/twilio-webhooks.test.js",
    "test:ui": "node tests/ui.e2e.mjs",
    "test:report": "node tests/make-report.mjs",
    "test:cleanup": "node tests/api.e2e.mjs --cleanup-only"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "messaging",
    "whatsapp",
    "telegram",
    "gmail",
    "scheduler",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.6",
    "prisma": "^5.22.0",
    "teleproto": "^1.229.0",
    "twilio": "^6.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.7",
    "puppeteer-core": "^23.11.1"
  },
  "nodemonConfig": {
    "ignore": [
      "tests/*",
      "uploads/*"
    ]
  }
}
