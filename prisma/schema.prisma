generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Platform {
  id                  Int                      @id @default(autoincrement()) @db.SmallInt
  code                String                   @unique @db.VarChar(20)
  name                String                   @db.VarChar(50)
  isActive            Boolean                  @default(true) @map("is_active")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  contactHandles      ContactPlatformHandle[]
  preferredByContacts Contact[]
  jobRecipients       JobRecipient[]
  deliveries          MessageDelivery[]
  replies             ContactReply[]
  templates           Template[]
  credentials         UserPlatformCredential[]

  @@map("platforms")
}

model MessageStatus {
  id            Int                 @id @default(autoincrement()) @db.SmallInt
  code          String              @unique @db.VarChar(20)
  description   String              @db.VarChar(100)
  newStatusLogs DeliveryStatusLog[] @relation("NewStatus")
  oldStatusLogs DeliveryStatusLog[] @relation("OldStatus")
  deliveries    MessageDelivery[]
  scheduledJobs ScheduledJob[]

  @@map("message_statuses")
}

model RecurrenceType {
  id              Int              @id @default(autoincrement()) @db.SmallInt
  code            String           @unique @db.VarChar(20)
  description     String           @db.VarChar(100)
  recurrenceRules RecurrenceRule[]

  @@map("recurrence_types")
}

model FileType {
  id          Int                 @id @default(autoincrement()) @db.SmallInt
  code        String              @unique @db.VarChar(20)
  mimePrefix  String              @map("mime_prefix") @db.VarChar(50)
  attachments MessageAttachment[]

  @@map("file_types")
}

model User {
  id                      Int                      @id @default(autoincrement())
  firstName               String                   @map("first_name") @db.VarChar(100)
  lastName                String                   @map("last_name") @db.VarChar(100)
  email                   String                   @unique @db.VarChar(255)
  passwordHash            String                   @map("password_hash") @db.VarChar(255)
  isVerified              Boolean                  @default(false) @map("is_verified")
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamp(6)
  contactGroups           ContactGroup[]
  contacts                Contact[]
  messages                Message[]
  notificationPreferences NotificationPreference?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  scheduledJobs           ScheduledJob[]
  templates               Template[]
  platformCredentials     UserPlatformCredential[]

  @@index([email], map: "idx_users_email")
  @@map("users")
}

/// Single-use password-reset tokens. Only the SHA-256 hash of the token is
/// stored, so a database leak can't be replayed against the reset endpoint.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_prt_user_id")
  @@index([expiresAt], map: "idx_prt_expires_at")
  @@map("password_reset_tokens")
}

/// Server-side refresh-token registry. Makes logout real (the token is
/// revoked, not just dropped by the client) and lets /auth/refresh rotate:
/// each use revokes the old token and issues a new one, so a stolen refresh
/// token is detectable and short-lived.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_rt_user_id")
  @@index([expiresAt], map: "idx_rt_expires_at")
  @@map("refresh_tokens")
}

model UserPlatformCredential {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  platformId     Int       @map("platform_id") @db.SmallInt
  encryptedToken String    @map("encrypted_token")
  tokenIv        String    @map("token_iv") @db.VarChar(255)
  extraInfo      Json      @default("{}") @map("extra_info")
  isActive       Boolean   @default(true) @map("is_active")
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamp(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  platform       Platform  @relation(fields: [platformId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, platformId])
  @@index([userId], map: "idx_upc_user_id")
  @@index([platformId], map: "idx_upc_platform_id")
  @@map("user_platform_credentials")
}

model NotificationPreference {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique @map("user_id")
  notifyOnFailure     Boolean  @default(true) @map("notify_on_failure")
  notifyOnSuccess     Boolean  @default(false) @map("notify_on_success")
  notifyOnTokenExpiry Boolean  @default(true) @map("notify_on_token_expiry")
  digestFrequency     String   @default("weekly") @map("digest_frequency") @db.VarChar(20)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notification_preferences")
}

/// User-facing operational alerts. `in_app` is the durable push payload; a
/// browser/mobile gateway can consume these rows after a device reconnects.
model Notification {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  deliveryId  Int?      @unique @map("delivery_id")
  type        String    @db.VarChar(50)
  title       String    @db.VarChar(255)
  body        String
  channel     String    @default("in_app") @db.VarChar(20)
  emailSentAt DateTime? @map("email_sent_at") @db.Timestamp(6)
  readAt      DateTime? @map("read_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@map("notifications")
}

model Contact {
  id                  Int                     @id @default(autoincrement())
  userId              Int                     @map("user_id")
  firstName           String                  @map("first_name") @db.VarChar(100)
  lastName            String?                 @map("last_name") @db.VarChar(100)
  preferredPlatformId Int?                    @map("preferred_platform_id") @db.SmallInt
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt           DateTime?               @map("deleted_at") @db.Timestamp(6)
  emails              ContactEmail[]
  groupMemberships    ContactGroupMember[]
  phones              ContactPhone[]
  platformHandles     ContactPlatformHandle[]
  preferredPlatform   Platform?               @relation(fields: [preferredPlatformId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobRecipients       JobRecipient[]
  deliveries          MessageDelivery[]
  replies             ContactReply[]

  @@index([userId], map: "idx_contacts_user_id")
  @@map("contacts")
}

/// Inbound replies. Content is intentionally not retained: smart-send only
/// needs the time, sender, and platform.
model ContactReply {
  id         Int      @id @default(autoincrement())
  contactId  Int      @map("contact_id")
  platformId Int      @map("platform_id") @db.SmallInt
  repliedAt  DateTime @default(now()) @map("replied_at") @db.Timestamp(6)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contactId, platformId, repliedAt], map: "idx_contact_replies_lookup")
  @@map("contact_replies")
}

model ContactPhone {
  id        Int      @id @default(autoincrement())
  contactId Int      @map("contact_id")
  phone     String   @db.VarChar(20)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([contactId, phone])
  @@index([contactId], map: "idx_contact_phones_contact_id")
  @@map("contact_phones")
}

model ContactEmail {
  id        Int      @id @default(autoincrement())
  contactId Int      @map("contact_id")
  email     String   @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([contactId, email])
  @@index([contactId], map: "idx_contact_emails_contact_id")
  @@map("contact_emails")
}

model ContactPlatformHandle {
  id         Int       @id @default(autoincrement())
  contactId  Int       @map("contact_id")
  platformId Int       @map("platform_id") @db.SmallInt
  /// What the USER typed and what the UI shows — "@aarav", a phone number.
  handle     String    @db.VarChar(255)
  /// The platform's own opaque address, when it differs from `handle`.
  ///
  /// Telegram is the reason this exists: the Bot API addresses a private
  /// user only by numeric chat_id, and there is no way to look one up from
  /// an @username. The id is captured when the contact first messages the
  /// bot (see webhooks.service.js) and stored here, so `handle` can stay the
  /// readable @username the user recognises. Null until that happens.
  chatId     String?   @map("chat_id") @db.VarChar(64)
  /// When the chat id was captured — null while the contact is unlinked.
  linkedAt   DateTime? @map("linked_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  platform   Platform  @relation(fields: [platformId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([contactId, platformId])
  @@index([contactId], map: "idx_cph_contact_id")
  @@index([platformId], map: "idx_cph_platform_id")
  @@index([platformId, chatId], map: "idx_cph_platform_chat_id")
  @@map("contact_platform_handles")
}

model ContactGroup {
  id            Int                  @id @default(autoincrement())
  userId        Int                  @map("user_id")
  name          String               @db.VarChar(100)
  description   String?              @db.VarChar(255)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamp(6)
  members       ContactGroupMember[]
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobRecipients JobRecipient[]

  @@index([userId], map: "idx_contact_groups_user_id")
  @@map("contact_groups")
}

model ContactGroupMember {
  contactId Int          @map("contact_id")
  groupId   Int          @map("group_id")
  addedAt   DateTime     @default(now()) @map("added_at") @db.Timestamp(6)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([contactId, groupId])
  @@index([groupId], map: "idx_cgm_group_id")
  @@index([contactId], map: "idx_cgm_contact_id")
  @@map("contact_group_members")
}

model Template {
  id         Int                @id @default(autoincrement())
  userId     Int                @map("user_id")
  platformId Int?               @map("platform_id") @db.SmallInt
  title      String             @db.VarChar(100)
  content    String
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  messages   Message[]
  variables  TemplateVariable[]
  platform   Platform?          @relation(fields: [platformId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_templates_user_id")
  @@map("templates")
}

/// A {placeholder} in a Template's content, plus where its value comes from.
///
/// `source` splits the two fill modes:
///   'manual'  — the sender types a value when they pick the template; one
///               value for the whole send, substituted before the message row
///               is written.
///   'contact' — read off each recipient's own Contact row (`contactField`),
///               so the value differs per delivery. These placeholders stay
///               literal in Message.content and are substituted by the
///               delivery worker, one recipient at a time.
model TemplateVariable {
  id           Int      @id @default(autoincrement())
  templateId   Int      @map("template_id")
  variableName String   @map("variable_name") @db.VarChar(50)
  defaultValue String?  @map("default_value") @db.VarChar(255)
  isRequired   Boolean  @default(false) @map("is_required")
  source       String   @default("manual") @db.VarChar(20)
  contactField String?  @map("contact_field") @db.VarChar(30)
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([templateId, variableName])
  @@map("template_variables")
}

model Message {
  id            Int                 @id @default(autoincrement())
  userId        Int                 @map("user_id")
  templateId    Int?                @map("template_id")
  content       String
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  attachments   MessageAttachment[]
  template      Template?           @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scheduledJobs ScheduledJob[]

  @@index([userId], map: "idx_messages_user_id")
  @@map("messages")
}

model MessageAttachment {
  id            Int      @id @default(autoincrement())
  messageId     Int      @map("message_id")
  fileTypeId    Int      @map("file_type_id") @db.SmallInt
  fileName      String   @map("file_name") @db.VarChar(255)
  fileUrl       String   @map("file_url") @db.VarChar(500)
  fileSizeBytes Int      @map("file_size_bytes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  fileType      FileType @relation(fields: [fileTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("message_attachments")
}

model RecurrenceRule {
  id               Int            @id @default(autoincrement())
  recurrenceTypeId Int            @map("recurrence_type_id") @db.SmallInt
  intervalValue    Int            @default(1) @map("interval_value") @db.SmallInt
  daysOfWeek       String?        @map("days_of_week") @db.VarChar(20)
  dayOfMonth       Int?           @map("day_of_month") @db.SmallInt
  monthOfYear      Int?           @map("month_of_year") @db.SmallInt
  endDate          DateTime?      @map("end_date") @db.Date
  maxOccurrences   Int?           @map("max_occurrences")
  recurrenceType   RecurrenceType @relation(fields: [recurrenceTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduledJobs    ScheduledJob[]

  @@map("recurrence_rules")
}

model ScheduledJob {
  id               Int               @id @default(autoincrement())
  userId           Int               @map("user_id")
  messageId        Int               @map("message_id")
  recurrenceRuleId Int?              @map("recurrence_rule_id")
  statusId         Int               @default(1) @map("status_id") @db.SmallInt
  scheduledAt      DateTime          @map("scheduled_at") @db.Timestamp(6)
  nextRunAt        DateTime?         @map("next_run_at") @db.Timestamp(6)
  /// How many times this job has fired. Counts missed runs that the scheduler
  /// skipped during catch-up too, so RecurrenceRule.maxOccurrences stays
  /// accurate across worker downtime.
  occurrenceCount  Int               @default(0) @map("occurrence_count")
  skipIfReplied    Boolean           @default(false) @map("skip_if_replied")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  recipients       JobRecipient[]
  deliveries       MessageDelivery[]
  message          Message           @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recurrenceRule   RecurrenceRule?   @relation(fields: [recurrenceRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           MessageStatus     @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_sj_user_id")
  @@index([statusId], map: "idx_sj_status_id")
  @@index([nextRunAt], map: "idx_sj_next_run")
  @@index([scheduledAt], map: "idx_sj_scheduled_at")
  @@map("scheduled_jobs")
}

model JobRecipient {
  id         Int           @id @default(autoincrement())
  jobId      Int           @map("job_id")
  contactId  Int?          @map("contact_id")
  groupId    Int?          @map("group_id")
  platformId Int           @map("platform_id") @db.SmallInt
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group      ContactGroup? @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job        ScheduledJob  @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  platform   Platform      @relation(fields: [platformId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jobId], map: "idx_jr_job_id")
  @@index([contactId], map: "idx_jr_contact_id")
  @@index([groupId], map: "idx_jr_group_id")
  @@map("job_recipients")
}

model MessageDelivery {
  id                Int                 @id @default(autoincrement())
  jobId             Int                 @map("job_id")
  contactId         Int                 @map("contact_id")
  platformId        Int                 @map("platform_id") @db.SmallInt
  statusId          Int                 @map("status_id") @db.SmallInt
  platformMessageId String?             @map("platform_message_id") @db.VarChar(255)
  sentAt            DateTime?           @map("sent_at") @db.Timestamp(6)
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamp(6)
  readAt            DateTime?           @map("read_at") @db.Timestamp(6)
  retryCount        Int                 @default(0) @map("retry_count") @db.SmallInt
  errorReason       String?             @map("error_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  statusLogs        DeliveryStatusLog[]
  contact           Contact             @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job               ScheduledJob        @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  platform          Platform            @relation(fields: [platformId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status            MessageStatus       @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jobId], map: "idx_md_job_id")
  @@index([contactId], map: "idx_md_contact_id")
  @@index([statusId], map: "idx_md_status_id")
  @@index([platformId], map: "idx_md_platform_id")
  @@index([platformMessageId], map: "idx_md_platform_message_id")
  @@index([sentAt], map: "idx_md_sent_at")
  @@map("message_deliveries")
}

model DeliveryStatusLog {
  id          Int             @id @default(autoincrement())
  deliveryId  Int             @map("delivery_id")
  oldStatusId Int?            @map("old_status_id") @db.SmallInt
  newStatusId Int             @map("new_status_id") @db.SmallInt
  changedBy   String          @default("system") @map("changed_by") @db.VarChar(20)
  changedAt   DateTime        @default(now()) @map("changed_at") @db.Timestamp(6)
  delivery    MessageDelivery @relation(fields: [deliveryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newStatus   MessageStatus   @relation("NewStatus", fields: [newStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  oldStatus   MessageStatus?  @relation("OldStatus", fields: [oldStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([deliveryId], map: "idx_dsl_delivery_id")
  @@map("delivery_status_logs")
}
